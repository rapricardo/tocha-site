---
import { Image } from 'astro:assets';
import logoAmarelo from '../assets/logo-web-amarelo.webp';
import WhatsAppCTA from './WhatsAppCTA.astro';
const links = [
  { label: 'O trabalho', href: '/#o-que-faco' },
  { label: 'Athena', href: '/#athena' },
  { label: 'Como trabalho', href: '/#como-trabalho' },
];
---
<nav class="site-nav" aria-label="Navegação principal">
  <div class="site-wrap site-nav-main">
    <a href="/" aria-label="Ricardo Tocha — início"><Image src={logoAmarelo} alt="Ricardo Tocha" width={160} height={40} class="site-logo" loading="eager" /></a>
    <div class="site-nav-links">{links.map(link => <a href={link.href}>{link.label}</a>)}</div>
    <WhatsAppCTA context="um problema da minha operação" label="WhatsApp" />
  </div>
</nav>
