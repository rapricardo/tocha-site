---
import TrackingHiddenFields from './TrackingHiddenFields.astro';

interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = 'Acompanhe a construção.',
  description = 'O diário de quem opera um ecossistema inteiro com IA: o que entrou em produção, o que quebrou e como foi feito. Direto no seu e-mail.',
} = Astro.props;
---

<div class="js-newsletter bg-[#111] border border-gray-800 p-8 md:p-10 relative overflow-hidden">
  <!-- Barra superior amarela -->
  <div class="absolute top-0 left-0 w-full h-1 bg-yellow-500"></div>

  <span class="inline-flex items-center gap-2 text-yellow-500 font-mono text-sm mb-3">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
    Newsletter
  </span>

  <h2 class="text-2xl md:text-3xl font-bold font-industrial text-white uppercase tracking-tight mb-3 leading-none">
    {heading}
  </h2>
  <p class="text-gray-400 text-sm md:text-base leading-relaxed mb-8 max-w-2xl">
    {description}
  </p>

  <!-- Estado de sucesso -->
  <div class="js-newsletter-success" style="display:none">
    <h3 class="text-xl font-bold font-industrial text-white uppercase mb-2">Pronto. Você está na lista.</h3>
    <p class="text-gray-400 text-sm">Sem spam. Saia quando quiser.</p>
  </div>

  <form class="js-newsletter-form">
    <!-- Estado de erro -->
    <p class="js-newsletter-error" style="display:none">
      <span class="text-red-500 text-sm">Erro ao enviar. Tente novamente.</span>
    </p>

    <!-- ===== CAMPOS OCULTOS PADRAO GTM ===== -->
    <TrackingHiddenFields />

    <div class="flex flex-col md:flex-row gap-4">
      <label class="sr-only" for="newsletter-nome">Nome</label>
      <input
        id="newsletter-nome"
        type="text"
        name="name"
        required
        class="flex-1 bg-[#0a0a0a] border border-gray-700 text-white p-3.5 focus:border-yellow-500 focus:outline-none transition-colors placeholder-gray-700"
        placeholder="Seu nome"
      />
      <label class="sr-only" for="newsletter-email">E-mail</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        required
        class="flex-1 bg-[#0a0a0a] border border-gray-700 text-white p-3.5 focus:border-yellow-500 focus:outline-none transition-colors placeholder-gray-700"
        placeholder="seu@email.com"
      />
      <button
        type="submit"
        class="shrink-0 bg-yellow-500 hover:bg-yellow-400 text-black font-bold uppercase tracking-widest px-8 py-3.5 text-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span class="js-newsletter-btn-label">Entrar na lista</span>
      </button>
    </div>
  </form>
</div>

<script>
  import { pushLeadSubmitEvent } from '../lib/tracking';

  const WEBHOOK_URL = 'https://apolo-lead-proxy.rapricardo.workers.dev';

  document.querySelectorAll<HTMLFormElement>('.js-newsletter-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const container = form.closest<HTMLElement>('.js-newsletter');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = form.querySelector<HTMLElement>('.js-newsletter-btn-label');
      const errorEl = form.querySelector<HTMLElement>('.js-newsletter-error');
      const originalLabel = label?.textContent ?? '';

      if (errorEl) errorEl.style.display = 'none';
      if (button) button.disabled = true;
      if (label) label.textContent = 'Enviando...';

      window.__wlPopulateHiddenFields?.(form);
      const tracking = window.__wlTracking || {};

      const payload: Record<string, unknown> = {};
      new FormData(form).forEach((value, key) => {
        payload[key] = value;
      });
      Object.keys(tracking).forEach((key) => {
        payload[key] = tracking[key];
      });

      pushLeadSubmitEvent({
        name: typeof payload.name === 'string' ? payload.name : null,
        email: typeof payload.email === 'string' ? payload.email : null,
      });

      payload.source = 'tocha_newsletter';

      try {
        await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const successEl = container?.querySelector<HTMLElement>('.js-newsletter-success');
        if (successEl) successEl.style.display = 'block';
        form.style.display = 'none';
      } catch {
        if (button) button.disabled = false;
        if (label) label.textContent = originalLabel;
        if (errorEl) errorEl.style.display = 'block';
      }
    });
  });
</script>
