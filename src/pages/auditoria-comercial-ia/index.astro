---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoAmarelo from '../../assets/logo-web-amarelo.webp';
import ServiceEcosystem from '../../components/service/ServiceEcosystem.astro';
---

<Layout
  title="Inteligência e Performance Comercial com IA — Ricardo Tocha"
  description="Conecte CRM e atendimento e leia 100% das conversas de WhatsApp da operação, ao vivo. Descubra onde a receita vaza e o que fazer para recuperar negócio."
>

  <!-- NAV -->
  <nav class="fixed w-full z-50 bg-[#0a0a0a]/90 backdrop-blur-md border-b border-gray-800">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/">
        <Image src={logoAmarelo} alt="Ricardo Tocha" width={160} height={40} class="h-8 w-auto" />
      </a>
      <div class="hidden md:flex items-center gap-4">
        <a href="https://athena.app.br/autoavaliacao" target="_blank" rel="noopener noreferrer" class="bg-yellow-500 text-black text-xs font-bold uppercase tracking-widest px-4 py-2 hover:bg-yellow-400 transition-colors">
          Fazer Autoavaliação
        </a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-6 pt-20 pb-4">
    <a href="/" class="inline-block border border-gray-700 text-xs font-bold uppercase tracking-widest text-gray-300 px-4 py-2 hover:bg-white hover:text-black transition-colors">← Voltar para Home</a>
  </div>

  <!-- HERO -->
  <section class="relative min-h-[80vh] flex items-center pt-8 pb-20 px-6 border-b border-gray-800 bg-grid-pattern overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/50 via-transparent to-[#0a0a0a]"></div>
    <div class="max-w-5xl mx-auto w-full relative z-10 text-center">

      <div class="inline-flex items-center gap-2 border border-yellow-500/30 bg-yellow-500/10 text-yellow-500 text-xs font-bold uppercase tracking-widest font-mono px-4 py-1.5 mb-8">
        ATHENA • athena.app.br
      </div>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold font-industrial text-white uppercase tracking-tight leading-[1.1] mb-8">
        Você não perde negócio por preço. <span class="text-yellow-500">Perde por operação.</span>
      </h1>

      <div class="max-w-2xl mx-auto mb-12">
        <p class="text-lg md:text-xl text-gray-400 font-light leading-relaxed">
          O Athena conecta CRM e atendimento e lê 100% das conversas de WhatsApp da sua operação, ao vivo. Mostra onde o lead esfria, onde o follow-up não acontece e onde a equipe não vende igual — antes que a receita vaze de vez.
        </p>
      </div>

      <a href="https://athena.app.br/autoavaliacao" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-yellow-500 text-black font-bold uppercase tracking-widest px-8 py-4 text-sm hover:bg-yellow-400 transition-colors">
        Fazer a autoavaliação — 2 min, grátis
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <p class="text-gray-600 text-xs mt-4 uppercase tracking-widest font-mono">
        <a href="/#contato" class="text-yellow-600 hover:text-yellow-500 transition-colors">Prefere falar direto? Fale com a gente</a> · Também disponível como SaaS standalone em <a href="https://athena.app.br/" target="_blank" rel="noopener noreferrer" class="text-yellow-600 hover:text-yellow-500 transition-colors">athena.app.br</a>
      </p>

    </div>
  </section>

  <!-- O PROBLEMA -->
  <section class="py-24 px-6 border-b border-gray-800 bg-[#0f0f0f]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16">
        <span class="inline-flex items-center gap-2 text-yellow-500 font-mono text-sm mb-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          O Problema
        </span>
        <h2 class="text-3xl md:text-5xl font-bold font-industrial text-white uppercase tracking-tight max-w-3xl leading-none">
          A receita não vaza no anúncio. Vaza na operação.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Card 1: O lead que esfriou -->
        <div class="border border-gray-800 p-8 hover:border-yellow-500/50 transition-colors bg-[#0a0a0a]">
          <div class="shrink-0 p-3 bg-black border border-gray-700 inline-block mb-4">
            <!-- Clock icon -->
            <svg class="w-6 h-6 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold font-industrial text-white uppercase tracking-tight mb-3">O Lead Que Esfriou</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Cada lead que espera horas é receita esfriando no vácuo, e o concorrente respondendo primeiro.</p>
        </div>

        <!-- Card 2: O follow-up que ninguém deu -->
        <div class="border border-gray-800 p-8 hover:border-yellow-500/50 transition-colors bg-[#0a0a0a]">
          <div class="shrink-0 p-3 bg-black border border-gray-700 inline-block mb-4">
            <!-- Calendar icon -->
            <svg class="w-6 h-6 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
          </div>
          <h3 class="text-xl font-bold font-industrial text-white uppercase tracking-tight mb-3">O Follow-up Que Ninguém Deu</h3>
          <p class="text-gray-400 text-sm leading-relaxed">Boa parte dos leads marcados como "em negociação" não recebe contato há dias. O negócio não foi perdido — foi esquecido.</p>
        </div>

        <!-- Card 3: A equipe que não vende igual -->
        <div class="border border-gray-800 p-8 hover:border-yellow-500/50 transition-colors bg-[#0a0a0a]">
          <div class="shrink-0 p-3 bg-black border border-gray-700 inline-block mb-4">
            <!-- Users icon -->
            <svg class="w-6 h-6 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold font-industrial text-white uppercase tracking-tight mb-3">A Equipe Que Não Vende Igual</h3>
          <p class="text-gray-400 text-sm leading-relaxed">A distância entre o seu melhor e o seu pior vendedor é receita parada. O CRM não mostra essa diferença; ela só aparece na conversa real.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- A INTERVENÇÃO -->
  <section class="py-24 px-6 border-b border-gray-800 bg-[#0a0a0a]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16">
        <span class="inline-flex items-center gap-2 text-yellow-500 font-mono text-sm mb-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
          </svg>
          A Intervenção
        </span>
        <h2 class="text-3xl md:text-5xl font-bold font-industrial text-white uppercase tracking-tight max-w-3xl leading-none">
          Como o Athena mostra onde a receita vaza.
        </h2>
      </div>

      <div class="max-w-3xl space-y-10">

        <div class="flex gap-6 items-start">
          <div class="shrink-0 w-10 h-10 bg-yellow-500 text-black flex items-center justify-center font-bold font-industrial text-lg">1</div>
          <div>
            <h3 class="text-lg font-bold font-industrial text-white uppercase tracking-tight mb-2">Conexão com CRM e Atendimento</h3>
            <p class="text-gray-400 text-sm leading-relaxed">O Athena se conecta ao seu CRM e à operação de atendimento no WhatsApp. Sem instalar nada no celular do vendedor.</p>
          </div>
        </div>

        <div class="flex gap-6 items-start">
          <div class="shrink-0 w-10 h-10 bg-yellow-500 text-black flex items-center justify-center font-bold font-industrial text-lg">2</div>
          <div>
            <h3 class="text-lg font-bold font-industrial text-white uppercase tracking-tight mb-2">Leitura de 100% das Conversas</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Lê 100% das conversas individuais de WhatsApp da operação, ao vivo a partir da conexão — com áudio transcrito. Sem amostragem, sem achismo.</p>
          </div>
        </div>

        <div class="flex gap-6 items-start">
          <div class="shrink-0 w-10 h-10 bg-yellow-500 text-black flex items-center justify-center font-bold font-industrial text-lg">3</div>
          <div>
            <h3 class="text-lg font-bold font-industrial text-white uppercase tracking-tight mb-2">Fila de Ação e Alertas</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Uma fila de ação diária mostra o que fazer primeiro. Alertas de SLA e de negociação estagnada chegam à gestão antes de o negócio esfriar de vez.</p>
          </div>
        </div>

        <div class="flex gap-6 items-start">
          <div class="shrink-0 w-10 h-10 bg-yellow-500 text-black flex items-center justify-center font-bold font-industrial text-lg">4</div>
          <div>
            <h3 class="text-lg font-bold font-industrial text-white uppercase tracking-tight mb-2">Boletim de Performance por Vendedor</h3>
            <p class="text-gray-400 text-sm leading-relaxed">Cada vendedor recebe um boletim com plano de ação. O Athena não só mostra o que aconteceu — aponta o que fazer e confere se foi feito.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- PROVA: CASE IBREP -->
  <section class="py-24 px-6 border-b border-gray-800 bg-[#0f0f0f]">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16">
        <span class="inline-flex items-center gap-2 text-yellow-500 font-mono text-sm mb-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Caso Real
        </span>
        <h2 class="text-3xl md:text-5xl font-bold font-industrial text-white uppercase tracking-tight leading-none">
          IBREP — Receita Recuperada Sem Trocar de CRM
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border border-gray-800">

        <div class="p-8 md:p-10 border-b md:border-b-0 md:border-r border-gray-800">
          <p class="text-yellow-500 font-mono text-xs uppercase tracking-widest mb-4">O Sangramento</p>
          <p class="text-gray-300 text-sm leading-relaxed">Rede de educação com 25 vendedores em 4 unidades investia em tráfego pago, mas 40% dos leads nunca recebiam follow-up. O CRM mostrava pipeline saudável; a operação dizia outra coisa.</p>
        </div>

        <div class="p-8 md:p-10 border-b md:border-b-0 md:border-r border-gray-800">
          <p class="text-yellow-500 font-mono text-xs uppercase tracking-widest mb-4">A Intervenção</p>
          <p class="text-gray-300 text-sm leading-relaxed">O Athena conectou CRM e atendimento e passou a ler 100% das conversas de WhatsApp da operação, ao vivo. A fila de ação e os alertas de estagnação substituíram a leitura por amostragem manual.</p>
        </div>

        <div class="p-8 md:p-10">
          <p class="text-yellow-500 font-mono text-xs uppercase tracking-widest mb-4">O Lucro Protegido</p>
          <p class="text-gray-300 text-sm leading-relaxed">Speed-to-lead caiu de 6h12min para 12 minutos. A conversão subiu de 8% para 11% (+37% em termos relativos) — com o mesmo investimento em marketing.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ECOSSISTEMA DE SERVIÇOS -->
  <ServiceEcosystem currentTool="athena" />

  <!-- CTA FINAL -->
  <section class="py-24 px-6 bg-[#0a0a0a] relative bg-grid-pattern">
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <h2 class="text-3xl md:text-5xl font-bold font-industrial text-white uppercase tracking-tight mb-4 leading-none">
        Quer ver onde a sua receita está vazando?
      </h2>
      <p class="text-gray-400 mb-8">
        A autoavaliação é gratuita, leva 2 minutos e não conecta nenhum dado. <strong class="text-white">Depois, se fizer sentido, a gente conecta o seu CRM de verdade.</strong>
      </p>
      <a
        href="https://athena.app.br/autoavaliacao"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-yellow-500 text-black text-sm font-bold uppercase tracking-widest px-6 py-3 hover:bg-yellow-400 transition-colors"
      >
        Fazer a autoavaliação — 2 min, grátis
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <div class="mt-4">
        <a href="/#contato" class="text-gray-500 text-xs font-mono uppercase tracking-widest hover:text-yellow-500 transition-colors">
          Ou fale sobre o seu caso →
        </a>
      </div>
    </div>
  </section>

</Layout>
