---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import LabConsole from '../components/LabConsole.astro';
import '../styles/laboratory.css';
const work = [
  'Coloco a IA para executar tarefas que hoje tomam tempo de quem deveria estar vendendo.',
  'Transformo o conhecimento dos seus melhores profissionais em orientação que o restante da equipe consegue usar.',
  'Organizo o trabalho no sistema para cada pessoa saber o próximo passo e o que ficou combinado.',
  'Acompanho com você se as mudanças melhoraram o resultado e ajusto o que precisar.',
];
const steps = [
  ['Entendo', 'Olho com você onde a equipe perde tempo, depende de ajuda ou deixa uma venda parar.'],
  ['Defino', 'Escolhemos o que melhorar primeiro e como saber se funcionou.'],
  ['Construo', 'Integro as ferramentas e coloco no sistema as tarefas e orientações que ajudam a equipe a trabalhar.'],
  ['Coloco em uso', 'Acompanho a equipe usando o sistema no trabalho real e ajusto o que atrapalha.'],
  ['Avalio', 'Comparo com você o resultado antes e depois da mudança.'],
  ['Aprimoro', 'Incorporo o que funcionou à rotina e uso o aprendizado para orientar a próxima melhoria.'],
];
const rooms = [['laboratorio', 'Laboratório'], ['o-que-faco', 'O que eu faço'], ['athena', 'Athena'], ['como-trabalho', 'Como eu trabalho'], ['contato', 'Como começar']];
---
<Layout title="Sistemas de gestão comercial sob medida | Ricardo Tocha" description="Coloque a IA para trabalhar na sua operação e dê à equipe condições de vender melhor.">
  <div class="lab-home" data-room="0" data-transition="false">
    <div class="journey-stage" id="lab-viewport" aria-hidden="true"><div class="lab-static"><div class="static-architecture"></div><span>RT</span></div></div>
    <div class="journey-shade" aria-hidden="true"></div>
    <Nav />
    <p id="room-announcement" class="sr-only" role="status" aria-live="polite"></p>
    <div class="journey-settings"><button type="button" id="lab-motion" aria-pressed="false">Pausar movimento</button></div>
    <nav class="room-map" aria-label="Ambientes do laboratório">{rooms.map(([id, label], i) => <a href={`#${id}`} data-room-link><span class="map-number">{String(i+1).padStart(2,'0')}</span><span>{label}</span></a>)}</nav>
    <div class="room-hotspots" aria-label="Portas do laboratório">{rooms.slice(1).map(([id, label],i)=><a class="room-hotspot" href={`#${id}`} data-hotspot={i} aria-label={`Ir para ${label}`}><b>{String(i+2).padStart(2,'0')}</b><span>{label}<i aria-hidden="true">↗</i></span></a>)}</div>

    <section class="room opening is-active" id="inicio" data-room-panel="0" aria-labelledby="home-title">
      <div class="room-copy">
        <p class="eyebrow"><span class="signal-dot"></span> IA aplicada a negócios</p>
        <h1 id="home-title" tabindex="-1">Sistemas de<br/> gestão comercial<br/> <em>sob medida.</em></h1>
        <p class="opening-support">Coloque a IA para trabalhar na sua operação e dê à equipe condições de vender melhor.</p>
        <div class="opening-actions"><a href="#laboratorio" class="site-button explore-button">Explorar o laboratório <span aria-hidden="true">↗</span></a><WhatsAppCTA context="melhorar minha operação comercial" /></div>
      </div>
    </section>

    <LabConsole />

    <section class="room work-room" id="o-que-faco" data-room-panel="2" aria-labelledby="work-title">
      <div class="room-copy">
        <p class="eyebrow">02</p><h2 id="work-title" tabindex="-1">O que eu <em>faço</em></h2>
        <ol class="work-list">{work.map((description, i) => <li><span>{String(i+1).padStart(2,'0')}</span><p>{description}</p></li>)}</ol>
        <details class="not-work"><summary>O que eu não faço <span aria-hidden="true">+</span></summary><ul><li>Entregar um diagnóstico e deixar você resolver sozinho como colocar em prática.</li><li>Instalar ferramentas e deixar a equipe descobrir como trabalhar com elas.</li><li>Encerrar o trabalho no treinamento, sem acompanhar o que mudou na rotina.</li></ul></details>
        <a class="room-next" href="#athena">Athena <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="room athena-room" id="athena" data-room-panel="3" aria-labelledby="athena-title">
      <div class="room-copy">
        <p class="eyebrow">03 / Athena</p><h2 id="athena-title" tabindex="-1">O que seus melhores vendedores fazem que o restante <em>ainda não faz?</em></h2>
        <p class="room-support">Com o Athena, você compara as conversas do WhatsApp com os resultados no CRM e identifica práticas para testar com o restante da equipe.</p>
        <a class="site-button" href="https://athena.app.br/">Conhecer o Athena <span aria-hidden="true">↗</span></a>
        <a class="room-next" href="#como-trabalho">Como eu trabalho <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="room method-room" id="como-trabalho" data-room-panel="4" aria-labelledby="method-title">
      <div class="room-copy">
        <p class="eyebrow">04</p><h2 id="method-title" tabindex="-1">Como eu <em>trabalho</em></h2>
        <div class="method-steps">{steps.map(([title, description], i) => <details class="method-step" name="method" open={i === 0}><summary><span>{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><b aria-hidden="true">+</b></summary><p>{description}</p></details>)}</div>
        <p class="method-caption">O que a equipe aprende em cada tentativa fica registrado para orientar a próxima decisão.</p>
        <a class="room-next" href="#contato">Como começar <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="room contact-room" id="contato" data-room-panel="5" aria-labelledby="contact-title">
      <div class="room-copy">
        <p class="eyebrow">05</p><h2 id="contact-title" tabindex="-1">Como <em>começar</em></h2>
        <ol class="contact-steps"><li>Me conte o que você quer melhorar na sua operação comercial.</li><li>Conversamos sobre como a equipe trabalha e o que está dificultando o resultado.</li><li>Você recebe uma proposta com o que será feito, o investimento e os próximos passos.</li></ol>
        <WhatsAppCTA context="melhorar minha operação comercial" />
        <div class="room-footer"><span>Ricardo Tocha</span><a href="https://athena.app.br/">Athena</a><a href="/membros/login/">Acessos existentes</a></div>
      </div>
    </section>
    <a class="back-to-lab" href="#laboratorio">← <span>Laboratório</span></a>
    <noscript><style is:inline>.journey-settings,.room-map,.room-hotspots,.back-to-lab{display:none!important}</style></noscript>
  </div>

</Layout>
