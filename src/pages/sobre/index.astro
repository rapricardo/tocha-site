---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import tochaBio from '../../assets/tocha-bio.webp';

const siteUrl = 'https://ricardotocha.com.br';

const sistemas = [
  {
    nome: 'Athena',
    tagline: 'Inteligência e performance comercial',
    dominio: 'athena.app.br',
    href: '/auditoria-comercial-ia/',
    area: 'Vendas + Atendimento',
  },
  {
    nome: 'Ângulo',
    tagline: 'Prospecção em grupos de WhatsApp',
    dominio: 'angulo.ia.br',
    href: '/prospeccao-whatsapp-ia/',
    area: 'Vendas',
  },
  {
    nome: 'Mercúrio',
    tagline: 'ERP/CRM unificado por IA',
    dominio: 'mercurio.ia.br',
    href: '/gestao-integrada-ia/',
    area: 'Operação',
  },
  {
    nome: 'ApexMkt',
    tagline: 'Operações de marketing com IA para agências',
    dominio: 'Lista de espera',
    href: '/operacoes-marketing-ia/',
    area: 'Marketing',
  },
  {
    nome: 'Máquina de Produção',
    tagline: 'Vídeo com IA',
    dominio: 'Pipeline interno',
    href: '/video-ia/',
    area: 'Marketing',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${siteUrl}/sobre/#aboutpage`,
  url: `${siteUrl}/sobre/`,
  name: 'Sobre Ricardo Tocha',
  inLanguage: 'pt-BR',
  mainEntity: { '@id': `${siteUrl}/#person` },
};
---

<Layout
  title="Sobre | Ricardo Tocha"
  description="Ajudo profissionais a fazer sozinhos, com IA, o trabalho que antes exigia uma equipe — e provo que funciona mostrando os sistemas reais que construo e opero todos os dias."
>
  <Nav />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO: AUTHORITY STATEMENT -->
  <section class="relative pt-32 md:pt-40 pb-16 px-6 bg-grid-pattern overflow-hidden border-b border-gray-800">
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/30 via-transparent to-[#0a0a0a]"></div>
    <div class="max-w-4xl mx-auto relative z-10">
      <span class="inline-flex items-center gap-2 text-yellow-500 font-mono text-sm mb-6">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
        Sobre
      </span>
      <h1 class="text-2xl md:text-4xl lg:text-[2.75rem] font-bold font-industrial text-white uppercase tracking-tight leading-tight">
        Ajudo profissionais a fazer <span class="text-yellow-500">sozinhos, com IA</span>, o trabalho que antes exigia uma equipe — e provo que funciona mostrando os <span class="text-yellow-500">sistemas reais</span> que construo e opero todos os dias.
      </h1>
    </div>
  </section>

  <!-- BIO -->
  <section class="py-24 px-6 border-b border-gray-800 bg-[#0a0a0a]">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center md:items-start gap-12">
      <div class="shrink-0 border border-gray-700 overflow-hidden bg-gray-800">
        <Image src={tochaBio} alt="Ricardo Tocha" class="object-cover" loading="eager" />
      </div>

      <div>
        <span class="inline-flex items-center gap-2 text-yellow-500 font-mono text-sm mb-2">
          Quem está por trás
        </span>
        <h2 class="text-3xl md:text-4xl font-bold font-industrial text-white uppercase tracking-tight mb-6 leading-none">
          Sempre fui executor.
        </h2>
        <div class="space-y-4 text-gray-400 leading-relaxed text-sm md:text-base">
          <p>
            Gravitei entre marketing, vendas, produto, design, código, processos e comunicação. Por muito tempo, essa mistura parecia difícil de explicar. Na era da IA, virou vantagem: a especialidade agora existe sob demanda, e o meu papel é saber onde aplicar, como conectar com o negócio e como transformar intenção em sistema funcionando.
          </p>
          <p>
            Há cerca de um ano, todo o meu tempo produtivo passa por LLMs e assistentes de código. Nesse período coloquei em produção, sozinho, um ecossistema que antes exigiria equipes de produto, engenharia e marketing.
          </p>
          <p>
            Antes disso, estruturei funis B2B, dei palestras sobre vendas, criei universidades corporativas comerciais e desenhei operações para empresas que precisavam vender melhor.
          </p>
          <p>
            Não vendo IA como novidade. Uso IA para corrigir gargalos reais de venda, atendimento, gestão e operação. O resultado está nos sistemas abaixo, todos em produção.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SISTEMAS EM PRODUÇÃO -->
  <section class="py-24 px-6 border-b border-gray-800 bg-[#0f0f0f] relative overflow-hidden">
    <div class="absolute top-0 right-0 w-1/3 h-full bg-yellow-500/5 -skew-x-12 transform origin-top-right"></div>
    <div class="max-w-4xl mx-auto relative z-10">
      <span class="inline-flex items-center gap-2 text-yellow-500 font-mono text-sm mb-4">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.384 3.18A1 1 0 015 17.482V6.518a1 1 0 011.036-.868l5.384 3.18m0 0l5.384-3.18A1 1 0 0118 6.518v10.964a1 1 0 01-1.036.868l-5.384-3.18z" /></svg>
        Prova de trabalho
      </span>
      <h2 class="text-3xl md:text-5xl font-bold font-industrial text-white uppercase tracking-tight leading-none mb-12">
        Sistemas em produção.
      </h2>

      <div class="space-y-4">
        {
          sistemas.map((sistema) => (
            <a
              href={sistema.href}
              class="flex flex-col md:flex-row md:items-center justify-between gap-3 border border-gray-800 hover:border-yellow-500/50 bg-[#0a0a0a] p-6 transition-colors group"
            >
              <div>
                <h3 class="text-lg md:text-xl font-bold font-industrial text-white uppercase tracking-tight group-hover:text-yellow-500 transition-colors">
                  {sistema.nome}
                  <span class="text-gray-500 font-light normal-case tracking-normal"> — {sistema.tagline}</span>
                </h3>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-yellow-500 uppercase tracking-widest text-xs font-mono">{sistema.dominio}</span>
                <span class="text-[10px] uppercase tracking-widest font-mono text-gray-500 border border-gray-800 px-2 py-0.5">
                  {sistema.area}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="py-20 px-6 border-b border-gray-800 bg-[#0a0a0a]">
    <div class="max-w-4xl mx-auto">
      <NewsletterForm />
    </div>
  </section>

  <!-- CTA DUPLO -->
  <section class="py-24 px-6 bg-grid-pattern relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <h2 class="text-3xl md:text-5xl font-bold font-industrial text-white uppercase tracking-tight leading-none mb-8">
        O caminho a partir daqui.
      </h2>
      <p class="text-gray-400 text-sm md:text-base leading-relaxed mb-12 max-w-2xl mx-auto">
        O manifesto explica a tese. O contato abre a conversa.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/manifesto/"
          class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-400 text-black font-bold uppercase tracking-widest px-8 py-4 text-base transition-colors"
          style="clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);"
        >
          Ler o manifesto
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
        <a
          href="/#contato"
          class="inline-flex items-center gap-2 border border-gray-700 hover:border-yellow-500 text-gray-300 hover:text-yellow-500 font-bold uppercase tracking-widest px-8 py-4 text-base transition-colors"
        >
          Falar comigo
        </a>
      </div>
    </div>
  </section>
</Layout>
