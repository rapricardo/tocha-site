---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }).format(date);
---

<Layout
  title="Blog | Ricardo Tocha — Diário de construção"
  description="Artigos sobre sistemas reais construídos e operados com IA: decisões de arquitetura, erros de percurso e resultados em produção."
>
  <Nav />

  <!-- HERO -->
  <section class="relative pt-32 md:pt-40 pb-16 px-6 bg-grid-pattern overflow-hidden border-b border-gray-800">
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/30 via-transparent to-[#0a0a0a]"></div>
    <div class="max-w-4xl mx-auto relative z-10">
      <span class="inline-flex items-center gap-2 text-yellow-500 font-mono text-sm mb-4">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
        Blog
      </span>
      <h1 class="text-4xl md:text-6xl font-bold font-industrial text-white uppercase tracking-tight leading-[0.95] mb-6">
        Diário de <span class="text-yellow-500">construção</span>.
      </h1>
      <p class="text-lg md:text-xl text-gray-400 font-light leading-relaxed max-w-2xl">
        Cada artigo documenta um sistema real: a decisão, o erro e o resultado em produção.
      </p>
    </div>
  </section>

  <!-- LISTAGEM -->
  <section class="py-20 px-6 border-b border-gray-800 bg-[#0a0a0a]">
    <div class="max-w-4xl mx-auto">
      {
        posts.length === 0 ? (
          <div class="border border-dashed border-gray-800 p-12 md:p-16 text-center">
            <p class="text-yellow-500 font-mono text-xs uppercase tracking-widest mb-4">// Primeiros artigos em breve</p>
            <p class="text-gray-400 text-sm md:text-base leading-relaxed max-w-xl mx-auto">
              Os primeiros artigos estão em produção. Entre na lista abaixo e receba cada um assim que sair.
            </p>
          </div>
        ) : (
          <div class="space-y-6">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="block border border-gray-800 hover:border-yellow-500/50 bg-[#0a0a0a] p-8 transition-colors group"
              >
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="text-gray-500 font-mono text-xs uppercase tracking-widest"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                  {post.data.tags.map((tag) => (
                    <span class="text-[10px] uppercase tracking-widest font-mono text-yellow-500/80 border border-yellow-500/30 px-1.5 py-0.5">
                      {tag}
                    </span>
                  ))}
                </div>
                <h2 class="text-xl md:text-2xl font-bold font-industrial text-white uppercase tracking-tight mb-2 group-hover:text-yellow-500 transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-gray-400 text-sm md:text-base leading-relaxed">{post.data.description}</p>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="py-20 px-6 bg-[#0f0f0f]">
    <div class="max-w-4xl mx-auto">
      <NewsletterForm />
    </div>
  </section>
</Layout>
