---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = 'https://ricardotocha.com.br';
const postUrl = `${siteUrl}/blog/${post.id}/`;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }).format(date);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  inLanguage: 'pt-BR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  author: { '@id': `${siteUrl}/#person` },
};
---

<Layout title={`${post.data.title} | Ricardo Tocha`} description={post.data.description}>
  <Nav />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- CABEÇALHO DO POST -->
  <section class="relative pt-32 md:pt-40 pb-12 px-6 bg-grid-pattern overflow-hidden border-b border-gray-800">
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/30 via-transparent to-[#0a0a0a]"></div>
    <div class="max-w-3xl mx-auto relative z-10">
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 text-gray-500 hover:text-yellow-500 font-mono text-xs uppercase tracking-widest mb-8 transition-colors"
      >
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" /></svg>
        Voltar ao blog
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-4">
        <time
          datetime={post.data.pubDate.toISOString()}
          class="text-gray-500 font-mono text-xs uppercase tracking-widest"
        >
          {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.tags.map((tag) => (
            <span class="text-[10px] uppercase tracking-widest font-mono text-yellow-500/80 border border-yellow-500/30 px-1.5 py-0.5">
              {tag}
            </span>
          ))
        }
      </div>

      <h1 class="text-3xl md:text-5xl font-bold font-industrial text-white uppercase tracking-tight leading-[1.05] mb-4">
        {post.data.title}
      </h1>
      <p class="text-base md:text-lg text-gray-400 font-light leading-relaxed border-l-2 border-yellow-500/50 pl-6">
        {post.data.description}
      </p>
    </div>
  </section>

  <!-- CORPO -->
  <article class="py-16 px-6 border-b border-gray-800 bg-[#0a0a0a]">
    <div class="max-w-3xl mx-auto prose">
      <Content />
    </div>
  </article>

  <!-- NEWSLETTER -->
  <section class="py-20 px-6 bg-[#0f0f0f]">
    <div class="max-w-3xl mx-auto">
      <NewsletterForm
        heading="Gostou? Tem mais chegando."
        description="Entre na lista e receba os próximos artigos: sistemas reais, decisões de arquitetura e o que aprendi construindo."
      />
    </div>
  </section>
</Layout>

<style>
  @reference "../../styles/global.css";

  .prose :global(h2) {
    @apply text-2xl md:text-3xl font-bold font-industrial text-white uppercase tracking-tight mt-12 mb-4;
  }
  .prose :global(h3) {
    @apply text-xl md:text-2xl font-bold font-industrial text-white tracking-tight mt-10 mb-3;
  }
  .prose :global(p) {
    @apply text-gray-300 leading-relaxed mb-5 text-sm md:text-base;
  }
  .prose :global(a) {
    @apply text-yellow-500 underline underline-offset-4 hover:text-yellow-400 transition-colors;
  }
  .prose :global(ul) {
    @apply text-gray-300 mb-5 pl-6 space-y-2 text-sm md:text-base list-disc;
  }
  .prose :global(ol) {
    @apply text-gray-300 mb-5 pl-6 space-y-2 text-sm md:text-base list-decimal;
  }
  .prose :global(blockquote) {
    @apply border-l-2 border-yellow-500 pl-6 text-gray-300 italic my-8;
  }
  .prose :global(strong) {
    @apply text-white font-semibold;
  }
  .prose :global(code) {
    @apply font-mono text-yellow-500 text-sm bg-[#111] px-1.5 py-0.5;
  }
  .prose :global(pre) {
    @apply bg-[#111] border border-gray-800 p-4 overflow-x-auto mb-6;
  }
  .prose :global(pre code) {
    @apply bg-transparent p-0 text-gray-300;
  }
  .prose :global(img) {
    @apply max-w-full border border-gray-800 my-8;
  }
  .prose :global(hr) {
    @apply border-gray-800 my-10;
  }
</style>
