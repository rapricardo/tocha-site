  <Nav />
  <section class="site-section"><div class="site-wrap">
    <p class="site-eyebrow">404</p><h1 style="font-size:clamp(32px,6vw,64px);line-height:1.1;color:#ede7da">Esta página não está disponível.</h1>
    <p style="margin:24px 0">Conheça o trabalho atual de Ricardo Tocha na página inicial.</p>
    <a class="site-button" href="/">Ir para a página inicial <span aria-hidden="true">↗</span></a>
  </div></section>
</Layout>
